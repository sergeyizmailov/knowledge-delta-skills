{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaops.local/schemas/workspace.v1.json",
  "title": "MetaOps workspace",
  "type": "object",
  "required": ["schema", "name", "api_version", "profiles", "defaults"],
  "properties": {
    "schema": {"const": "metaops.workspace/v1"},
    "name": {"type": "string", "minLength": 1},
    "api_version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"},
    "blocked_accounts": {
      "type": "array",
      "items": {"type": "string", "pattern": "^act_[0-9]+$"},
      "uniqueItems": true
    },
    "risk": {"$ref": "#/$defs/risk"},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
      "additionalProperties": {"$ref": "#/$defs/profile"}
    },
    "defaults": {
      "type": "object",
      "required": ["profile"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "token_env": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"},
        "token_envs": {
          "type": "object",
          "properties": {
            "business_read": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"},
            "catalog": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"},
            "events_write": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"},
            "rules": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"}
          },
          "additionalProperties": false
        },
        "allow_no_proxy": {"type": "boolean"},
        "state_dir": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "profile": {
      "type": "object",
      "required": [
        "business_id", "ad_account_id", "page_id",
        "dataset_id", "currency", "timezone"
      ],
      "properties": {
        "business_id": {"type": "string", "pattern": "^[0-9]+$"},
        "app_id": {"type": "string", "pattern": "^[0-9]+$"},
        "system_user_id": {"type": "string", "pattern": "^[0-9]+$"},
        "ad_account_id": {"type": "string", "pattern": "^act_[0-9]+$"},
        "page_id": {"type": "string", "pattern": "^[0-9]+$"},
        "instagram_user_id": {"type": "string", "pattern": "^(auto|[0-9]+)$"},
        "dataset_id": {"type": "string", "pattern": "^[0-9]+$"},
        "catalog_id": {"type": "string", "pattern": "^[0-9]+$"},
        "feed_id": {"type": "string", "pattern": "^[0-9]+$"},
        "keitaro_campaign_id": {"type": "string", "pattern": "^[0-9]+$"},
        "token_kind": {"type": "string", "enum": ["system_user", "user", "auto"]},
        "product_sets": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
          "additionalProperties": {"type": "string", "pattern": "^[0-9]+$"}
        },
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "timezone": {"type": "string", "minLength": 1},
        "risk": {"$ref": "#/$defs/risk"}
      },
      "additionalProperties": false
    },
    "risk": {
      "description": "doctor --risk thresholds: the operator's own priors, no Meta source ties them to disables. Profile values override workspace values, which override the code defaults.",
      "type": "object",
      "properties": {
        "min_account_age_days": {"type": "number", "minimum": 0},
        "min_amount_spent": {"type": "number", "minimum": 0},
        "min_pixel_age_days": {"type": "number", "minimum": 0},
        "min_page_followers": {"type": "number", "minimum": 0},
        "max_disapproved_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "disapproved_high_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "min_ads_for_ratio": {"type": "integer", "minimum": 1},
        "ads_window_days": {"type": "integer", "minimum": 1},
        "ads_max_pages": {"type": "integer", "minimum": 1},
        "spend_cap_near_ratio": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  }
}
